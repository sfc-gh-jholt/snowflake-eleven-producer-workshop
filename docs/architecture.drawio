<mxfile host="app.diagrams.net" type="device">
 <diagram id="current" name="Current - generic external orchestration">
  <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1200" pageHeight="1000"><root>
   <mxCell id="0"/><mxCell id="1" parent="0"/>
   <mxCell id="title" value="Current pattern: separate map, runtime and data" style="text;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="60" as="geometry"/></mxCell>
   <mxCell id="control" value="External orchestration service" style="swimlane;startSize=35;fillColor=#fff2cc;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1120" height="260" as="geometry"/></mxCell>
   <mxCell id="map" value="Job definitions, dependencies and run status" style="rounded=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="control"><mxGeometry x="40" y="80" width="280" height="120" as="geometry"/></mxCell>
   <mxCell id="dispatcher" value="Dispatcher: poll required parents and substitute parameters" style="rounded=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="control"><mxGeometry x="420" y="80" width="280" height="120" as="geometry"/></mxCell>
   <mxCell id="runtime" value="Workflow execution runtime" style="rounded=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="control"><mxGeometry x="800" y="80" width="280" height="120" as="geometry"/></mxCell>
   <mxCell id="data" value="Warehouse: eleven producer outputs feed two business jobs" style="swimlane;startSize=35;fillColor=#dae8fc;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1120" height="260" as="geometry"/></mxCell>
   <mxCell id="inventory" value="Inventory procedure" style="rounded=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="data"><mxGeometry x="40" y="80" width="280" height="120" as="geometry"/></mxCell>
   <mxCell id="quality" value="Prepare result and apply application quality rules" style="rounded=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="data"><mxGeometry x="420" y="80" width="280" height="120" as="geometry"/></mxCell>
   <mxCell id="publish" value="Publish current and historical data" style="rounded=1;whiteSpace=wrap;fontSize=17;" vertex="1" parent="data"><mxGeometry x="800" y="80" width="280" height="120" as="geometry"/></mxCell>
   <mxCell id="note" value="Illustrative pattern only. No organization, real platform inventory or production quality policy is represented." style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1120" height="100" as="geometry"/></mxCell>
